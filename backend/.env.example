PORT=3000
NODE_ENV=development
API_PREFIX=api

# PostgreSQL via Prisma
DATABASE_URL="postgresql://fitflow:fitflowpass@localhost:5432/fitflow_db?schema=public"

# MongoDB for Social Feed
MONGODB_URI="mongodb://localhost:27017/fitflow_mongo"

# Redis Cache and Pub/Sub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# FastAPI AI Microservice URL
AI_SERVICE_URL="http://localhost:8001"

# S3 / MinIO Object Storage
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="fitflow-media"

# Firebase Auth & Cloud Messaging
FIREBASE_PROJECT_ID="fitflow-redesign"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@fitflow-redesign.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY=""

# Dev Auth Bypass
DEV_AUTH_BYPASS_ENABLED=true
DEV_USER_ID="usr_demo_777"
